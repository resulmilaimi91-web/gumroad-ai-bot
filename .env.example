# --- Obligative ---
OPENAI_API_KEY=sk-your-openai-key-here
GUMROAD_ACCESS_TOKEN=your-gumroad-token-here

# --- Groq (Falas — alternativë e OpenAI) ---
USE_GROQ=true
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram (Opsional) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Oraret e cikleve (default: 08:00,13:00,20:00) ---
SCHEDULE_TIMES=08:00,13:00,20:00

# --- Guardrails (Kufij Sigurie) ---
MIN_PRICE_USD=5.00
MAX_DISCOUNT_PERCENT=40

# --- Modaliteti testues ---
DRY_RUN=false
